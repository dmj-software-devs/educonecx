APP_NAME=EDUCONECX
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://educonecx.com

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=educonecx
DB_USERNAME=
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="support@educonecx.com"
MAIL_FROM_NAME="${APP_NAME}"

HEYGEN_API_KEY=
LIVEAVATAR_API_KEY=
HEYGEN_BASE_URL=https://api.heygen.com
HEYGEN_STREAMING_TOKEN_ENDPOINT=/v1/streaming.create_token
HEYGEN_STREAMING_START_ENDPOINT=/v1/streaming.start
HEYGEN_DEFAULT_AVATAR_ID=
HEYGEN_DEFAULT_VOICE_ID=
HEYGEN_DEFAULT_CONTEXT_ID=
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=
HEYGEN_CONTEXT_ID=

OPENAI_API_KEY=
OPENAI_EVALUATION_MODEL=gpt-5.4
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe

PRACTICE_ROOM_NEW_USER_CREDITS=20
PRACTICE_ROOM_PRACTICE_CREDIT_COST=1
PRACTICE_ROOM_EXAM_CREDIT_COST=2
PRACTICE_ROOM_DEFAULT_COURSE_CREDITS=20
